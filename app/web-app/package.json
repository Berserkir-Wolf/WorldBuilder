{
  "name": "WorldBuilder",
  "version": "0.0.2",
  "main": "server.js",
  "file_function": "This is the package.json file for the Docker web application. It defines the application's metadata, scripts, and dependencies.",
  "scripts": {
    "build": "vite build",
    "docker:build": "node scripts/build-image.js",
    "start": "prisma db push && npm run prisma:seed && npm run prisma:migrate && node server.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "node prisma/migrate.js",
    "prisma:seed": "node prisma/seed.js"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "express": "^4.19.2",
    "express-session": "^1.19.0",
    "prisma": "^6.19.3",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.1",
    "eslint": "^10.13.0",
    "vite": "^6.1.0",
    "vue": "^3.5.13"
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "@scarf/scarf@1.4.0": true,
    "@prisma/engines@6.19.3": true
  }
}

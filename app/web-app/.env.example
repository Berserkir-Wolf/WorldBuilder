# Database provider: sqlite or mysql
DATABASE_PROVIDER=sqlite

# SQLite (default)
DATABASE_URL=file:/app/data/worldbuilder.db

# MySQL alternative
# DATABASE_PROVIDER=mysql
# DATABASE_URL=mysql://worldbuilder:change-me@mysql:3306/worldbuilder
# MYSQL_HOST=mysql
# MYSQL_PORT=3306
# MYSQL_DATABASE=worldbuilder
# MYSQL_USER=worldbuilder
# MYSQL_PASSWORD=change-me

# Application mounting path
BASE_URL=/

# Upload storage path
UPLOAD_FOLDER=/app/data/uploads

# Authentication
SESSION_SECRET=replace-with-a-long-random-secret
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me
